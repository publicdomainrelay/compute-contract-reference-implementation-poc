{
  "lexicon": 1,
  "id": "com.publicdomainrelay.temp.market.submitBid",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit the AT-URI and CID of a bid record directly to the RFP issuer, bypassing the firehose. Used when the RFP includes a submitBid service DID reference. Must be called via PDS service-proxying (atproto-proxy); the receiver verifies the inter-service auth JWT and requires its issuer to be the DID that authored the referenced bid record.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid", "record"],
          "properties": {
            "uri": {
              "type": "string",
              "description": "AT-URI of the bid record."
            },
            "cid": {
              "type": "string",
              "description": "CID of the bid record."
            },
            "record": {
              "type": "ref",
              "ref": "com.publicdomainrelay.temp.market.bid",
              "description": "The bid record itself, including a strong reference to the RFP it is for."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": {
              "type": "boolean"
            }
          }
        }
      },
      "errors": [
        { "name": "InvalidRequest" }
      ]
    }
  }
}
