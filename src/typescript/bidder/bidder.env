# Non-secret config + secret STUBS. Committed. Real secrets in bidder.env.secrets
# (gitignored), loaded after this file so they override the stubs below.
RBAC_REPO_ROOT=/home/johnandersen777/src/rbac/homelab-0002/wid-atp
X402_MAKE_FREE=1
DIGITALOCEAN_BASE_URL=https://mini-cloud-0001.fedfork.com
# Where rebuild.sh writes liveos-<distro>.img; mounted into the qemu-runner
# container at /root/.cache/simple-qemu (else "Disk image not found").
CACHE_DIR=/home/johnandersen777/.cache/simple-qemu
# Local compute provider (QEMU VM mode is the default) for the WooTTY flow.
COMPUTE_PROVIDER=local
# The local provider serves its workload-identity OIDC issuer
# (/v1/oidc/{issue,prove}) on ISSUER_PORT over HTTP; Caddy fronts it publicly at
# ISSUER_URL so provisioned VMs can reach prove/issue. Replaces the standalone
# qemu.service (mini-cloud-0001 Caddy upstream is 127.0.0.1:9000).
ISSUER_URL=https://mini-cloud-0001.fedfork.com
ISSUER_PORT=9000
BASE_URL=https://bob-bid-0001--johnandersen777-bsky-social.fedproxy.com
ATPROTO_HANDLE=johnandersen777.bsky.social
ATPROTO_USERNAME=johnandersen777.bsky.social
ATPROTO_DID=did:plc:5svqtrhheairglgiiyvutzik
ATPROTO_PDS=https://morel.us-east.host.bsky.network

